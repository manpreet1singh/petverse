DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Leave unset to use SQLite. With docker compose running:
# DATABASE_URL=postgres://petverse:petverse@localhost:5432/petverse
# true = OTP codes are printed in the server console instead of sent by SMS
OTP_DEV_MODE=true
